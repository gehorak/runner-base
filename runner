#!/bin/bash

# =============================================================================
# runner — v0.3.0 compatibility-bridge dispatcher
#
# PURPOSE
# -------
# Single public entrypoint for every Runner image. It owns canonical CLI
# parsing, metadata discovery, and transparent tool/program execution.
#
# DESIGN PRINCIPLES
# -----------------
# - Canonical commands take precedence over bridge aliases.
# - Derived images declare tools; directory discovery never creates commands.
# - Legacy syntax normalizes into one canonical implementation path.
# - Metadata is validated data, never evaluated shell input.
# - Child argument boundaries, stdout, stderr, signals, and exit codes survive.
# =============================================================================

set -Eeuo pipefail

# Do not trust a caller-provided PATH for Runner-owned commands. The absolute
# shebang and EUID guard below run before metadata loading or child dispatch.
readonly RUNNER_SYSTEM_PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PATH="${RUNNER_SYSTEM_PATH}"

# =============================================================================
# Fixed platform locations (CONTRACT)
# =============================================================================

readonly METADATA_LIB="/usr/local/lib/runner/metadata.sh"
readonly IMAGE_ENV="/etc/runner/image.env"
readonly RUNTIME_ENV="/etc/runner/runtime.env"
readonly TOOLS_ENV="/etc/runner/tools.env"

# =============================================================================
# Runner-native diagnostics and JSON helpers
# =============================================================================

runner_error() {
  local identifier="$1"
  local message="$2"
  local hint="$3"
  local code="$4"

  if [[ "${RUNNER_ERROR_FORMAT:-text}" == "json" ]]; then
    printf '{"schema_version":1,"error":{"id":"%s","message":"%s","hint":"%s"}}\n' \
      "$(runner_json_string "$identifier")" \
      "$(runner_json_string "$message")" \
      "$(runner_json_string "$hint")" >&2
  else
    printf '%s: %s\nHint: %s\n' "$identifier" "$message" "$hint" >&2
  fi
  exit "$code"
}

runner_deprecation() {
  printf "DEPRECATED: %s\n" "$1" >&2
}

runner_json_string() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' -e 's/\r/\\r/g' -e 's/\n/\\n/g'
}

# =============================================================================
# Structured tool serialization
#
# Tool identity, version, aliases, and executable binding originate only from
# validated RUNNER_TOOL_* metadata. JSON remains the normative machine surface.
# =============================================================================

runner_json_tool() {
  local name="$1"
  local key=""
  local aliases_var=""
  local version_var=""
  local aliases=""
  local alias=""
  local first=1
  local IFS=','

  key="$(runner_metadata_tool_key "$name")"
  aliases_var="RUNNER_TOOL_${key}_ALIASES"
  version_var="RUNNER_TOOL_${key}_VERSION"
  aliases="${!aliases_var-}"
  printf '{"name":"%s","version":"%s","aliases":[' \
    "$(runner_json_string "$name")" \
    "$(runner_json_string "${!version_var}")"
  for alias in $aliases; do
    if [[ $first -eq 0 ]]; then
      printf ','
    fi
    printf '"%s"' "$(runner_json_string "$alias")"
    first=0
  done
  printf ']}'
}

runner_json_tools() {
  local name=""
  local first=1
  local IFS=','

  printf '['
  for name in $RUNNER_TOOL_NAMES; do
    if [[ $first -eq 0 ]]; then
      printf ','
    fi
    runner_json_tool "$name"
    first=0
  done
  printf ']'
}

# =============================================================================
# Canonical metadata commands
# =============================================================================

runner_help() {
  cat <<'EOF'
Usage:
  runner --help
  runner --version
  runner info [--format text|json]
  runner tool [--format text|json]
  runner tool <name> [arguments...]
  runner exec -- <program> [arguments...]
  runner shell

Commands:
  info     Show Runner, image, runtime, and tool metadata.
  tool     List tools or invoke one by canonical name.
  exec     Execute an explicit program after the required -- delimiter.
  shell    Start an interactive shell for human debugging.

Migration:
  Legacy v0.2.x forms are deprecated bridge aliases and will be removed in v1.0.0.
EOF
}

# runner --version describes Runner itself. Derived image version belongs in
# runner info and cannot override this canonical value.
runner_version() {
  printf 'runner %s (contract %s)\n' "$RUNNER_VERSION" "$RUNNER_CONTRACT_VERSION"
}

# Text and JSON both render the same validated metadata model; no separate
# human-output data source is maintained.
runner_info_json() {
  printf '{"schema_version":1,"runner":{"name":"runner","version":"%s","contract_version":"%s"},' \
    "$(runner_json_string "$RUNNER_VERSION")" \
    "$(runner_json_string "$RUNNER_CONTRACT_VERSION")"
  printf '"image":{"name":"%s","version":"%s","domain":"%s","role":"%s","revision":"%s"},' \
    "$(runner_json_string "$RUNNER_IMAGE")" \
    "$(runner_json_string "$RUNNER_IMAGE_VERSION")" \
    "$(runner_json_string "$RUNNER_DOMAIN")" \
    "$(runner_json_string "$RUNNER_ROLE")" \
    "$(runner_json_string "$RUNNER_IMAGE_REVISION")"
  printf '"runtime":{"platform":"linux","architecture":"amd64","user":"%s","home":"%s","workdir":"%s","shell":"%s"},"tools":' \
    "$(runner_json_string "$RUNTIME_USER_NAME")" \
    "$(runner_json_string "$RUNTIME_USER_HOME")" \
    "$(runner_json_string "$RUNTIME_WORKDIR")" \
    "$(runner_json_string "$RUNTIME_SHELL")"
  runner_json_tools
  printf '}\n'
}

runner_info_text() {
  local name=""
  local key=""
  local version_var=""
  local IFS=','

  printf 'Runner: runner %s (contract %s)\n' "$RUNNER_VERSION" "$RUNNER_CONTRACT_VERSION"
  printf 'Image: %s %s\n' "$RUNNER_IMAGE" "$RUNNER_IMAGE_VERSION"
  printf 'Domain: %s\n' "$RUNNER_DOMAIN"
  printf 'Role: %s\n' "$RUNNER_ROLE"
  printf 'Runtime: %s\n' "$RUNNER_SUPPORTED_PLATFORM"
  printf 'User: %s\n' "$RUNTIME_USER_NAME"
  printf 'Home: %s\n' "$RUNTIME_USER_HOME"
  printf 'Workdir: %s\n' "$RUNTIME_WORKDIR"
  printf 'Shell: %s\n' "$RUNTIME_SHELL"
  printf 'Tools:'
  for name in $RUNNER_TOOL_NAMES; do
    key="$(runner_metadata_tool_key "$name")"
    version_var="RUNNER_TOOL_${key}_VERSION"
    printf ' %s %s' "$name" "${!version_var}"
  done
  printf '\n'
}

# Parse only the two frozen structured formats. The caller maps invalid syntax
# to the stable Runner usage/format exit-code contract.
runner_parse_format() {
  local default="$1"
  shift
  RUNNER_REQUESTED_FORMAT="$default"
  RUNNER_FORMAT_INPUT=""

  [[ $# -eq 0 ]] && return 0
  [[ $# -eq 2 && "$1" == "--format" ]] || return 1
  RUNNER_FORMAT_INPUT="$2"
  case "$2" in
    text | json)
      RUNNER_REQUESTED_FORMAT="$2"
      ;;
    *)
      return 1
      ;;
  esac
}

runner_info() {
  runner_parse_format text "$@" || runner_error RUNNER_E_FORMAT "Unsupported format: ${RUNNER_FORMAT_INPUT:-unknown}" "Use '--format text' or '--format json'." 2
  case "$RUNNER_REQUESTED_FORMAT" in
    text) runner_info_text ;;
    json) runner_info_json ;;
  esac
}

runner_tool_list() {
  local name=""
  local key=""
  local version_var=""
  local IFS=','

  runner_parse_format text "$@" || runner_error RUNNER_E_FORMAT "Unsupported format: ${RUNNER_FORMAT_INPUT:-unknown}" "Use '--format text' or '--format json'." 2
  if [[ "$RUNNER_REQUESTED_FORMAT" == "json" ]]; then
    printf '{"schema_version":1,"tools":'
    runner_json_tools
    printf '}\n'
    return 0
  fi
  for name in $RUNNER_TOOL_NAMES; do
    key="$(runner_metadata_tool_key "$name")"
    version_var="RUNNER_TOOL_${key}_VERSION"
    printf '%s %s\n' "$name" "${!version_var}"
  done
}

# =============================================================================
# Tool lookup and transparent execution
#
# Tool lookup accepts a canonical identity or an explicit bridge alias. It never
# derives an executable from the requested command name and never falls back to
# host/system command execution.
# =============================================================================

runner_resolve_tool() {
  local requested="$1"
  local name=""
  local key=""
  local aliases_var=""
  local alias=""
  local IFS=','

  for name in $RUNNER_TOOL_NAMES; do
    [[ "$requested" == "$name" ]] && {
      printf '%s' "$name"
      return 0
    }
    key="$(runner_metadata_tool_key "$name")"
    aliases_var="RUNNER_TOOL_${key}_ALIASES"
    for alias in ${!aliases_var-}; do
      [[ "$requested" == "$alias" ]] && {
        printf '%s' "$name"
        return 0
      }
    done
  done
  return 1
}

# The alias warning is emitted here only for canonical "runner tool <alias>".
# Direct legacy commands resolve their alias before reaching this function so
# every legacy invocation produces exactly one deprecation warning.
runner_tool_exec() {
  local requested="${1:-}"
  local canonical=""
  local key=""
  local executable_var=""
  local executable=""

  [[ -n "$requested" ]] || runner_error RUNNER_E_USAGE "missing tool name" "Use runner tool <name> [arguments...]." 2
  shift
  canonical="$(runner_resolve_tool "$requested")" || runner_error RUNNER_E_NOT_FOUND "Unknown tool: ${requested}" "Run 'runner tool --format text' to list available tools." 4
  if [[ "$requested" != "$canonical" ]]; then
    runner_deprecation "tool alias '${requested}' will be removed in v1.0.0; use canonical tool name '${canonical}'."
  fi
  key="$(runner_metadata_tool_key "$canonical")"
  executable_var="RUNNER_TOOL_${key}_EXECUTABLE"
  executable="${!executable_var}"
  [[ -x "$executable" ]] || runner_error RUNNER_E_NOT_EXECUTABLE "Tool is registered but cannot be executed: ${canonical}" "Verify the tool path and executable permissions in the derived image." 126
  exec "$executable" "$@"
}

runner_tool() {
  [[ $# -gt 0 ]] || {
    runner_tool_list
    return 0
  }
  if [[ "$1" == "--format" ]]; then
    runner_tool_list "$@"
    return 0
  fi
  runner_tool_exec "$@"
}

# =============================================================================
# Program execution and interactive shell
# =============================================================================

runner_exec() {
  [[ "${1:-}" == "--" ]] || runner_error RUNNER_E_USAGE "Canonical exec requires '--' followed by a program." "Use 'runner exec -- <program> [arguments...]'." 2
  shift
  [[ $# -gt 0 ]] || runner_error RUNNER_E_USAGE "Canonical exec requires '--' followed by a program." "Use 'runner exec -- <program> [arguments...]'." 2
  exec "$@"
}

# shell remains intentionally interactive-only. Automation must use exec --.
runner_shell() {
  [[ $# -eq 0 ]] || runner_error RUNNER_E_USAGE "shell accepts no arguments" "Use runner shell interactively or runner exec -- for a program." 2
  [[ -t 0 && -t 1 ]] || runner_error RUNNER_E_SHELL_TTY "shell requires an interactive terminal" "Use docker run -it ... shell." 2
  exec "$RUNTIME_SHELL"
}

# The materialized metadata describes the process that is already executing.
# Reject any derived-image drift between declared identity and actual UID/GID,
# user, HOME, workdir, or configured shell before dispatching a command.
runner_validate_runtime_environment() {
  [[ "$(/usr/bin/id -u)" == "${RUNTIME_USER_UID}" ]] || return 1
  [[ "$(/usr/bin/id -g)" == "${RUNTIME_USER_GID}" ]] || return 1
  [[ "$(/usr/bin/id -un)" == "${RUNTIME_USER_NAME}" ]] || return 1
  [[ "${HOME}" == "${RUNTIME_USER_HOME}" ]] || return 1
  [[ "${PWD}" == "${RUNTIME_WORKDIR}" ]] || return 1
  [[ -x "${RUNTIME_SHELL}" ]] || return 1
}

# =============================================================================
# Runtime contract loading (READ-ONLY)
#
# The parser library is a fixed trusted platform file. Materialized metadata is
# parsed and validated as literal data before any Runner command is dispatched.
# =============================================================================

# Select JSON diagnostics before metadata validation, because metadata commands
# may fail before their normal argument parser can run.
RUNNER_ERROR_FORMAT=text
if [[ "${1:-}" == "info" && "${2:-}" == "--format" && "${3:-}" == "json" && $# -eq 3 ]]; then
  RUNNER_ERROR_FORMAT=json
fi

[[ "${EUID}" -ne 0 ]] || runner_error RUNNER_E_ROOT "runner must not run as root" "Run the image with its declared non-root user." 2
[[ -f "$IMAGE_ENV" && -f "$RUNTIME_ENV" && -f "$TOOLS_ENV" && -f "$METADATA_LIB" ]] || runner_error RUNNER_E_CONTRACT "Required Runner metadata is missing or invalid." "Rebuild the image from valid declarative Runner metadata." 3

# METADATA_LIB is a fixed trusted parser path. Image metadata are parsed as data.
# shellcheck disable=SC1090,SC1091
source "$METADATA_LIB"
runner_metadata_validate_runtime_contract "$IMAGE_ENV" "$RUNTIME_ENV" "$TOOLS_ENV" >/dev/null 2>&1 || runner_error RUNNER_E_CONTRACT "Required Runner metadata is missing or invalid." "Rebuild the image from valid declarative Runner metadata." 3
runner_metadata_export_file "$IMAGE_ENV" >/dev/null 2>&1 || runner_error RUNNER_E_CONTRACT "Required Runner metadata is missing or invalid." "Rebuild the image from valid declarative Runner metadata." 3
runner_metadata_export_file "$RUNTIME_ENV" >/dev/null 2>&1 || runner_error RUNNER_E_CONTRACT "Required Runner metadata is missing or invalid." "Rebuild the image from valid declarative Runner metadata." 3
runner_metadata_export_file "$TOOLS_ENV" >/dev/null 2>&1 || runner_error RUNNER_E_CONTRACT "Required Runner metadata is missing or invalid." "Rebuild the image from valid declarative Runner metadata." 3
runner_validate_runtime_environment || runner_error RUNNER_E_CONTRACT "Runtime environment does not match declared metadata." "Rebuild the image with a consistent runtime contract." 3

# =============================================================================
# Main dispatch (DETERMINISTIC)
#
# Dispatch priority is canonical Runner surface, frozen bridge aliases,
# canonical tool lookup, deprecated direct tool lookup, then stable not-found.
# =============================================================================

command="${1:---help}"
shift || true

case "$command" in
  --help)
    [[ $# -eq 0 ]] || runner_error RUNNER_E_USAGE "help accepts no arguments" "Use runner --help." 2
    runner_help
    ;;
  --version)
    [[ $# -eq 0 ]] || runner_error RUNNER_E_USAGE "--version accepts no arguments" "Use runner --version." 2
    runner_version
    ;;
  info)
    runner_info "$@"
    ;;
  tool)
    runner_tool "$@"
    ;;
  exec)
    if [[ "${1:-}" != "--" ]]; then
      runner_deprecation "delimiter-free exec will be removed in v1.0.0; use 'runner exec -- <program> [arguments...]'."
      [[ $# -gt 0 ]] || runner_error RUNNER_E_USAGE "missing program" "Use runner exec -- <program> [arguments...]." 2
      exec "$@"
    fi
    runner_exec "$@"
    ;;
  shell)
    runner_shell "$@"
    ;;
  about)
    [[ $# -eq 0 ]] || runner_error RUNNER_E_USAGE "about accepts no arguments" "Use runner info --format text." 2
    runner_deprecation "'runner about' will be removed in v1.0.0; use 'runner info --format text'."
    runner_info --format text
    ;;
  version)
    [[ $# -eq 0 ]] || runner_error RUNNER_E_USAGE "version accepts no arguments" "Use runner --version." 2
    runner_deprecation "'runner version' will be removed in v1.0.0; use 'runner --version'."
    runner_version
    ;;
  *)
    [[ "$command" != --* ]] || runner_error RUNNER_E_USAGE "Unknown Runner option '${command}'." "Use runner --help." 2
    if runner_resolve_tool "$command" >/dev/null; then
      canonical="$(runner_resolve_tool "$command")"
      runner_deprecation "direct tool commands will be removed in v1.0.0; use 'runner tool <name> [arguments...]'."
      runner_tool_exec "$canonical" "$@"
    fi
    runner_error RUNNER_E_NOT_FOUND "Unknown Runner command." "Run 'runner --help' to list canonical commands." 4
    ;;
esac
