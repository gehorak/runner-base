{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runner.invalid/release/release-evidence.schema.json",
  "title": "Runner base release evidence",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "source",
    "image",
    "contract",
    "platform",
    "tests",
    "artifacts",
    "release_decision",
    "rollback_reference"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"const": "runner-base"},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "tag"],
      "properties": {
        "repository": {"const": "gehorak/runner-base"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "image": {
      "type": "object",
      "required": ["candidate_reference", "candidate_image_id", "published_reference", "published_digest", "parent_reference", "parent_digest"],
      "properties": {
        "candidate_reference": {"const": "runner-release:test"},
        "candidate_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "published_reference": {"type": "string", "pattern": "^ghcr\\.io/gehorak/runner-base:[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "published_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "parent_reference": {"type": "string", "pattern": "^debian:bookworm-slim@sha256:[0-9a-f]{64}$"},
        "parent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "contract": {
      "type": "object",
      "required": ["runner_contract_version", "cli_contract_track"],
      "properties": {
        "runner_contract_version": {"const": "legacy-v0.2"},
        "cli_contract_track": {"const": "legacy"}
      }
    },
    "platform": {"const": "linux/amd64"},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "object",
      "required": ["sbom_reference", "provenance_reference"],
      "properties": {
        "sbom_reference": {"type": "string", "minLength": 1},
        "provenance_reference": {"type": "string", "minLength": 1}
      }
    },
    "release_decision": {
      "type": "object",
      "required": ["status", "decided_by", "rationale"],
      "properties": {
        "status": {"const": "published"},
        "decided_by": {"const": "release-tag"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "rollback_reference": {
      "type": "object",
      "required": ["previous_reference", "previous_digest", "notes"],
      "properties": {
        "previous_reference": {"type": "string", "minLength": 1},
        "previous_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": false
}
